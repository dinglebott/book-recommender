# Google Books API key (free, from Google Cloud Console -> enable "Books API")
GOOGLE_BOOKS_API_KEY=

# Comma-separated list of accepted pre-shared tokens. Each token = one isolated reading list.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
VALID_TOKENS=token-for-user-one,token-for-user-two

# Path to the SQLite DB file. On Railway, point this at the mounted volume, e.g. /data/reading_list.db
DATABASE_PATH=./data/reading_list.db

# Descriptive User-Agent required by Open Library. Include a contact email.
OPEN_LIBRARY_USER_AGENT=ReadingListMCP/1.0 (contact: you@example.com)

# Provided by Railway at runtime; defaults to 8000 locally.
PORT=8000
